{
  "name": "dxtutor-ide",
  "version": "0.7.0",
  "private": true,
  "description": "dxtutor IDE — desktop app (Tauri 2 + Rust) for the Co-Dev prototype",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "npm run ui:build && tauri dev",
    "build": "tauri build",
    "test": "npm run ui:test && cargo test --workspace",
    "ui:build": "tsc --noEmit -p ui-app/tsconfig.json && vite build --config ui-app/vite.config.ts",
    "ui:test": "vitest run --config ui-app/vitest.config.ts",
    "docs:notes": "UPDATE_NOTES=1 vitest run --config ui-app/vitest.config.ts tests/notes.docs.test.ts",
    "lint": "eslint ui-app/src",
    "format": "prettier --write ui-app/src/features/diff/domain ui-app/src/features/router/domain ui-app/src/features/codev/domain/project-commands.ts eslint.config.js",
    "format:check": "prettier --check ui-app/src/features/diff/domain ui-app/src/features/router/domain ui-app/src/features/codev/domain/project-commands.ts eslint.config.js",
    "arch:check": "bash scripts/arch-check.sh && bash scripts/ui-metrics.sh",
    "ui:e2e": "playwright test --config ui-app/e2e/playwright.config.ts",
    "grammars:verify": "node scripts/fetch-grammars.mjs",
    "grammars:check": "node scripts/fetch-grammars.mjs --offline"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.15.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.11",
    "vitest": "^4.1.12"
  }
}
