{
  "name": "dxtutor-ide",
  "version": "0.7.0",
  "private": true,
  "description": "dxtutor IDE — desktop app (Tauri 2 + Rust) for the Co-Dev prototype",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "npm run ui:build && tauri dev",
    "dev:seed": "VITE_SEED=1 npm run ui:build && tauri dev",
    "build": "tauri build",
    "test": "npm run ui:test && cargo test --workspace",
    "ui:build": "tsc --noEmit -p ui-app/tsconfig.json && vite build --config ui-app/vite.config.ts",
    "ui:test": "vitest run --config ui-app/vitest.config.ts",
    "arch:check": "bash scripts/arch-check.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.12"
  }
}
