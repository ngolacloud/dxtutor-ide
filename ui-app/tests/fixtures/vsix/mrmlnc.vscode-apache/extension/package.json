{
  "name": "vscode-apache",
  "displayName": "Apache Conf",
  "description": "Syntax highlighter for Apache configuration files",
  "version": "1.2.0",
  "publisher": "mrmlnc",
  "license": "MIT",
  "contributes": {
    "languages": [
      {
        "id": "apacheconf",
        "aliases": [
          "Apache",
          "apache"
        ],
        "extensions": [
          "conf",
          ".conf",
          "htaccess",
          ".htaccess",
          "htgroups",
          ".htgroups",
          "htpasswd",
          ".htpasswd"
        ],
        "configuration": "./apache.configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "apacheconf",
        "scopeName": "source.apacheconf",
        "path": "./syntaxes/Apache.tmLanguage"
      }
    ]
  }
}
