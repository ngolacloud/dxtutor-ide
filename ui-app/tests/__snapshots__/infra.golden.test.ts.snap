exports[`caracterização do motor — runtime / dev-container / Kubernetes (a extrair p/ domain) > k8sInfra: manifestos (Deployment/Service/Secret/Ingress) a partir do design > k8sInfra 1`] = `
"# Local stand-ins for managed services, secrets for every app and the ingress.
# For a real cloud, delete the stand-ins and point the secrets at the managed services.
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: order-events
spec:
  replicas: 1
  selector:
    matchLabels: { app: order-events }
  template:
    metadata:
      labels: { app: order-events }
    spec:
      containers:
        - name: order-events
          image: softwaremill/elasticmq-native
          ports: [{ containerPort: 9324 }]
---
apiVersion: v1
kind: Service
metadata:
  name: order-events
spec:
  selector: { app: order-events }
  ports: [{ port: 9324, targetPort: 9324 }]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: orders-db
spec:
  replicas: 1
  selector:
    matchLabels: { app: orders-db }
  template:
    metadata:
      labels: { app: orders-db }
    spec:
      containers:
        - name: orders-db
          image: postgres:16-alpine
          env:
            - { name: POSTGRES_USER, value: "app" }
            - { name: POSTGRES_PASSWORD, value: "app" }
            - { name: POSTGRES_DB, value: "app" }
          ports: [{ containerPort: 5432 }]
---
apiVersion: v1
kind: Service
metadata:
  name: orders-db
spec:
  selector: { app: orders-db }
  ports: [{ port: 5432, targetPort: 5432 }]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: session-cache
spec:
  replicas: 1
  selector:
    matchLabels: { app: session-cache }
  template:
    metadata:
      labels: { app: session-cache }
    spec:
      containers:
        - name: session-cache
          image: redis:7-alpine
          ports: [{ containerPort: 6379 }]
---
apiVersion: v1
kind: Service
metadata:
  name: session-cache
spec:
  selector: { app: session-cache }
  ports: [{ port: 6379, targetPort: 6379 }]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: invoices-bucket
spec:
  replicas: 1
  selector:
    matchLabels: { app: invoices-bucket }
  template:
    metadata:
      labels: { app: invoices-bucket }
    spec:
      containers:
        - name: invoices-bucket
          image: minio/minio
          args: ["server", "/data", "--console-address", ":9001"]
          env:
            - { name: MINIO_ROOT_USER, value: "minio" }
            - { name: MINIO_ROOT_PASSWORD, value: "minio12345" }
          ports: [{ containerPort: 9000 }]
---
apiVersion: v1
kind: Service
metadata:
  name: invoices-bucket
spec:
  selector: { app: invoices-bucket }
  ports: [{ port: 9000, targetPort: 9000 }]
---
apiVersion: v1
kind: Secret
metadata:
  name: web-env
stringData:
  PORT: "8080"
  ORDERS_API_URL: "http://orders-api"
---
apiVersion: v1
kind: Secret
metadata:
  name: orders-api-env
stringData:
  PORT: "8080"
  DATABASE_URL: "postgres://app:app@orders-db:5432/app"
  REDIS_URL: "redis://session-cache:6379"
  SQS_ENDPOINT: "http://order-events:9324"
  AWS_REGION: "us-east-1"
---
apiVersion: v1
kind: Secret
metadata:
  name: billing-worker-env
stringData:
  PORT: "8080"
  SQS_ENDPOINT: "http://order-events:9324"
  AWS_REGION: "us-east-1"
  DATABASE_URL: "postgres://app:app@orders-db:5432/app"
  S3_ENDPOINT: "http://invoices-bucket:9000"
  AWS_ACCESS_KEY_ID: "minio"
  AWS_SECRET_ACCESS_KEY: "minio12345"
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: gateway
spec:
  rules:
    - http:
        paths:
          - path: /
            pathType: Prefix
            backend: { service: { name: web, port: { number: 80 } } }
          - path: /orders-api
            pathType: Prefix
            backend: { service: { name: orders-api, port: { number: 80 } } }
"
`;

