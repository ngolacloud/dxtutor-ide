exports[`goldens de DOM — estados estáticos > #pane-codev (conhecimento, checkpoints, routing, equipa, backlog, studio) 1`] = `
"<div class="side-hd"><span class="t">Co-Dev</span><span class="acts"><button title="Mission manager"><svg class="ico" viewBox="0 0 16 16"><circle cx="4" cy="4" r="1.6"></circle><circle cx="4" cy="12" r="1.6"></circle><circle cx="12" cy="8" r="1.6"></circle><path d="M4 5.6v4.8M5.4 4.8l5.2 2.5M5.4 11.2l5.2-2.5"></path></svg></button><button title="Settings"><svg class="ico" viewBox="0 0 16 16"><circle cx="8" cy="8" r="2.1"></circle><path d="M8 1.6v1.8M8 12.6v1.8M1.6 8h1.8M12.6 8h1.8M3.5 3.5l1.3 1.3M11.2 11.2l1.3 1.3M12.5 3.5l-1.3 1.3M4.8 11.2l-1.3 1.3"></path></svg></button></span></div><div class="sections"><div class="scm-grp">Team<span class="cnt">8</span></div><div class="scm-row" title="Orchestrator: decomposes, delegates and integrates"><span class="pdot" style="background:var(--accent)"></span><span class="nm">Co-Dev</span><span class="pth">**</span></div><div class="scm-row" title="Requirements, architecture, ADRs and backlog"><span class="pdot" style="background:var(--accent-hover)"></span><span class="nm">Architect</span><span class="pth">.dxtutor/**, docs/**, README.md</span></div><div class="scm-row" title="Serviços, APIs e lógica do backend"><span class="pdot" style="background:#dea584"></span><span class="nm">Backend</span><span class="pth">read-only</span></div><div class="scm-row" title="Schema, migrations and indexes"><span class="pdot" style="background:var(--green)"></span><span class="nm">Database</span><span class="pth">migrations/**, **/migrations/**, *.sql, **/*.sql</span></div><div class="scm-row" title="Interface and Design System"><span class="pdot" style="background:var(--blue)"></span><span class="nm">Frontend</span><span class="pth">read-only</span></div><div class="scm-row" title="Automated tests"><span class="pdot" style="background:var(--yellow)"></span><span class="nm">QA</span><span class="pth">tests/**, **/tests/**, test/**, **/test/**, **/*_test.*, **/*.test.*, **/*.spec.*, **/test_*.py</span></div><div class="scm-row" title="Infra, CI/CD e deploy"><span class="pdot" style="background:var(--purple)"></span><span class="nm">Platform</span><span class="pth">Dockerfile, **/Dockerfile, docker-compose*.yml, compose*.yml, Makefile, .github/**, .gitlab-ci.yml, deploy/**, k8s/**, helm/**, .env.example</span></div><div class="scm-row" title="Explains and guides; never writes for you"><span class="pdot" style="background:var(--cyan)"></span><span class="nm">Tutor</span><span class="pth">read-only</span></div><div class="scm-grp">Backlog<span class="cnt">0</span></div><div class="scm-row"><span class="ic"><svg class="ico" viewBox="0 0 16 16"><rect x="2" y="2.5" width="12" height="11" rx="1.2"></rect><path d="M8 2.5v11"></path></svg></span><span class="nm">Board</span><span class="pth">0 · 0 · 0 · 0 · 0 · 0</span></div><div class="scm-row"><span class="ic"><svg class="ico" viewBox="0 0 16 16"><path d="M8 1.9l5.4 3v6.2L8 14.1l-5.4-3V4.9z"></path><path d="M8 7.9l5.4-3M8 7.9v6.2M8 7.9L2.6 4.9"></path></svg></span><span class="nm">Studio</span><span class="pth">8 planned</span></div>
   <div class="scm-grp">Project knowledge<span class="cnt">7</span></div><div class="scm-row"><span class="ic x-md"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span class="nm" style="max-width:none">ADR-001-local-first</span></div><div class="scm-row"><span class="ic x-md"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span class="nm" style="max-width:none">ADR-002-camadas</span></div><div class="scm-row"><span class="ic x-md"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span class="nm" style="max-width:none">base-de-dados</span></div><div class="scm-row"><span class="ic x-md"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span class="nm" style="max-width:none">design-system</span></div><div class="scm-row"><span class="ic x-md"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span class="nm" style="max-width:none">padroes</span></div><div class="scm-row"><span class="ic x-md"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span class="nm" style="max-width:none">regras</span></div><div class="scm-row"><span class="ic x-md"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span class="nm" style="max-width:none">requisitos</span></div>
   <div class="scm-grp">Checkpoints<span class="cnt">0</span></div><div class="sec-empty">Created automatically before each mission and each correction.</div>
   <div class="scm-grp">Routing</div><div class="kv"><span class="pdot" style="background:var(--accent-hover)"></span>Planner<span class="v">Claude</span></div><div class="kv"><span class="pdot" style="background:var(--green)"></span>Coder<span class="v">Codex</span></div><div class="kv"><span class="pdot" style="background:var(--blue)"></span>Reviewer<span class="v">Gemini</span></div><div class="kv"><span class="pdot" style="background:var(--accent-hover)"></span>Judge<span class="v">Claude</span></div><div class="kv"><span class="pdot" style="background:var(--purple)"></span>Private / offline<span class="v">Ollama</span></div></div>"
`;

exports[`goldens de DOM — estados estáticos > chat depois de newChat() 1`] = `
"<div class="intro" id="ag-intro"><div class="i-t">Co-Dev</div><div class="i-s">I understand requirements, propose architecture, write, test, evaluate my own work and fix it — with you steering.</div>
  <button class="chip"><b>Explain the active file</b><small>Free question — answered by Claude live.</small></button>
  <div class="i-n" id="live-note"><span class="tag">not connected</span> open the dxtutor IDE desktop to talk to a model about the project's files.</div></div>"
`;

exports[`goldens de DOM — estados estáticos > página Definições (renderSettingsPage) 1`] = `
"<div class="page"><h1>Settings</h1><div class="sub">Saved in this browser. Real keys and endpoints live in the application keychain — here they only show the contract.</div>
  <h2>Models and providers</h2><div class="pgrid"><div class="pcard"><div class="ph"><span class="pdot" style="background:var(--accent-hover)"></span>Claude<span class="tag ">live unavailable here</span><button class="sw on" title="Turn on / off"></button></div>
    <div><label>Model</label><input value="claude-opus-5-5"></div><div><label>Endpoint</label><input value="https://api.anthropic.com"></div>
    <div><label>API key</label><input type="password" placeholder="stored in the keychain"></div><button class="mini">Test connection</button><div class="pd"></div></div><div class="pcard"><div class="ph"><span class="pdot" style="background:var(--blue)"></span>Gemini<span class="tag ">simulated</span><button class="sw on" title="Turn on / off"></button></div>
    <div><label>Model</label><input value="gemini-pro"></div><div><label>Endpoint</label><input value="https://generativelanguage.googleapis.com"></div>
    <div><label>API key</label><input type="password" placeholder="stored in the keychain"></div><button class="mini">Test connection</button><div class="pd"></div></div><div class="pcard"><div class="ph"><span class="pdot" style="background:var(--green)"></span>Codex<span class="tag ">simulated</span><button class="sw on" title="Turn on / off"></button></div>
    <div><label>Model</label><input value="gpt-codex"></div><div><label>Endpoint</label><input value="https://api.openai.com"></div>
    <div><label>API key</label><input type="password" placeholder="stored in the keychain"></div><button class="mini">Test connection</button><div class="pd"></div></div><div class="pcard"><div class="ph"><span class="pdot" style="background:var(--purple)"></span>Ollama<span class="tag ">local · simulated</span><button class="sw on" title="Turn on / off"></button></div>
    <div><label>Model</label><input value="qwen2.5-coder:14b"></div><div><label>Endpoint</label><input value="http://localhost:11434"></div>
    <div><label>Key (not needed)</label><input type="password" placeholder="—" disabled=""></div><button class="mini">Test connection</button><div class="pd"></div></div></div>
  <h2>Routing by role</h2><div class="tbl-wrap"><div class="rowline"><span class="pdot" style="background:var(--accent-hover)"></span><b>Planner</b><span style="color:var(--fg-muted)">requirements, architecture, plan</span><span class="sp"></span><select style="width:150px"><option value="claude" selected="">Claude</option><option value="gemini">Gemini</option><option value="codex">Codex</option><option value="ollama">Ollama</option></select></div><div class="rowline"><span class="pdot" style="background:var(--green)"></span><b>Coder</b><span style="color:var(--fg-muted)">writes and edits code</span><span class="sp"></span><select style="width:150px"><option value="claude">Claude</option><option value="gemini">Gemini</option><option value="codex" selected="">Codex</option><option value="ollama">Ollama</option></select></div><div class="rowline"><span class="pdot" style="background:var(--blue)"></span><b>Reviewer</b><span style="color:var(--fg-muted)">tests, lint, self-evaluation</span><span class="sp"></span><select style="width:150px"><option value="claude">Claude</option><option value="gemini" selected="">Gemini</option><option value="codex">Codex</option><option value="ollama">Ollama</option></select></div><div class="rowline"><span class="pdot" style="background:var(--accent-hover)"></span><b>Judge</b><span style="color:var(--fg-muted)">chooses between proposals</span><span class="sp"></span><select style="width:150px"><option value="claude" selected="">Claude</option><option value="gemini">Gemini</option><option value="codex">Codex</option><option value="ollama">Ollama</option></select></div><div class="rowline"><span class="pdot" style="background:var(--purple)"></span><b>Private / offline</b><span style="color:var(--fg-muted)">autocomplete and sensitive data</span><span class="sp"></span><select style="width:150px"><option value="claude">Claude</option><option value="gemini">Gemini</option><option value="codex">Codex</option><option value="ollama" selected="">Ollama</option></select></div></div><div class="sub" style="margin-top:8px">If the provider for a role is off, Co-Dev falls back to the first one that is on.</div>
  <h2>Autonomy</h2><div class="pgrid"><button class="pcard"><div class="ph">Manual</div><div class="pd">You decide everything: answers, proposal, plan, every edit and every command.</div></button><button class="pcard sel"><div class="ph">Assisted<span class="tag acc">active</span></div><div class="pd">Co-Dev decides what is safe and reversible; it asks you when confidence is low.</div></button><button class="pcard"><div class="ph">Auto</div><div class="pd">Autonomous end to end, with self-evaluation and correction. It only stops for push and destructive actions.</div></button></div>
  <div class="tbl-wrap" style="margin-top:10px"><table class="tbl"><tbody><tr><th>Action</th><th>Manual</th><th>Assisted</th><th>Auto</th></tr><tr><td>Answer clarification questions</td><td class="c">you</td><td class="on">Co-Dev if confidence ≥ 80%; otherwise it asks</td><td class="c">Co-Dev; below 80% it takes the reversible option and flags it</td></tr><tr><td>Choose between the models' proposals</td><td class="c">you, with the judge's recommendation</td><td class="on">judge</td><td class="c">judge</td></tr><tr><td>Approve the plan</td><td class="c">you</td><td class="on">automatic</td><td class="c">automatic</td></tr><tr><td>Edit files</td><td class="c">you approve each edit</td><td class="on">automatic, with diff</td><td class="c">automatic, with diff</td></tr><tr><td>Terminal: tests, build, lint</td><td class="c">you approve</td><td class="on">automatic</td><td class="c">automatic</td></tr><tr><td>Terminal: other commands</td><td class="c">you approve</td><td class="on">you approve</td><td class="c">automatic</td></tr><tr><td>Fix after failing self-evaluation</td><td class="c">you approve</td><td class="on">automatic (max. 2)</td><td class="c">automatic (max. 2)</td></tr><tr><td>Local commit</td><td class="c">you approve</td><td class="on">you approve</td><td class="c">automatic</td></tr><tr><td>Push and destructive actions</td><td class="c">you approve</td><td class="on">you approve</td><td class="c">you approve — always</td></tr></tbody></table></div>
  <h2>Appearance</h2><div class="pgrid"><button class="pcard sel"><div class="ph">Graphite orange<span class="tag acc">active</span></div></button><button class="pcard"><div class="ph">Slate indigo</div></button><button class="pcard"><div class="ph">Light paper</div></button></div>
  <h2>Keyboard shortcuts</h2><div class="tbl-wrap"><div class="rowline"><span>Go to file…</span><span class="sp"></span><kbd>Ctrl+P</kbd></div><div class="rowline"><span>Show all commands</span><span class="sp"></span><kbd>Ctrl+Shift+P</kbd></div><div class="rowline"><span>Go to line…</span><span class="sp"></span><kbd>Ctrl+G</kbd></div><div class="rowline"><span>Go to next problem</span><span class="sp"></span><kbd>F8</kbd></div><div class="rowline"><span>View: Explorer</span><span class="sp"></span><kbd>Ctrl+Shift+E</kbd></div><div class="rowline"><span>View: Search</span><span class="sp"></span><kbd>Ctrl+Shift+F</kbd></div><div class="rowline"><span>View: Source Control</span><span class="sp"></span><kbd>Ctrl+Shift+G</kbd></div><div class="rowline"><span>View: Toggle sidebar</span><span class="sp"></span><kbd>Ctrl+B</kbd></div><div class="rowline"><span>View: Toggle panel</span><span class="sp"></span><kbd>Ctrl+J</kbd></div><div class="rowline"><span>View: Terminal</span><span class="sp"></span><kbd>Ctrl+\`</kbd></div><div class="rowline"><span>View: Problems</span><span class="sp"></span><kbd>Ctrl+Shift+M</kbd></div><div class="rowline"><span>Co-Dev: Focus the conversation</span><span class="sp"></span><kbd>Ctrl+L</kbd></div><div class="rowline"><span>Co-Dev: Knowledge panel</span><span class="sp"></span><kbd>Ctrl+Shift+A</kbd></div><div class="rowline"><span>Preferences: Settings</span><span class="sp"></span><kbd>Ctrl+,</kbd></div></div></div>"
`;

exports[`goldens de DOM — estados estáticos > página Gestor de missões (renderManagerPage, estado inicial) 1`] = `
"<div class="page"><h1>Mission manager</h1><div class="sub">Everything Co-Dev did, decided and can undo.</div>
  <h2>Checkpoints</h2><div class="tbl-wrap"><div class="rowline" style="color:var(--fg-muted)">Created before each mission and each correction.</div></div>
  <h2>Usage by provider <span style="text-transform:none;letter-spacing:0;font-weight:400">(estimate)</span></h2><div class="tbl-wrap"><div class="rowline"><span class="pdot" style="background:var(--accent-hover)"></span><b>Claude</b><span style="color:var(--fg-muted)">Planner, Judge</span><span class="sp"></span><span>0 calls · 0.0k tokens</span></div><div class="rowline"><span class="pdot" style="background:var(--blue)"></span><b>Gemini</b><span style="color:var(--fg-muted)">Reviewer</span><span class="sp"></span><span>0 calls · 0.0k tokens</span></div><div class="rowline"><span class="pdot" style="background:var(--green)"></span><b>Codex</b><span style="color:var(--fg-muted)">Coder</span><span class="sp"></span><span>0 calls · 0.0k tokens</span></div><div class="rowline"><span class="pdot" style="background:var(--purple)"></span><b>Ollama</b><span style="color:var(--fg-muted)">Private / offline</span><span class="sp"></span><span>0 calls · 0.0k tokens</span></div></div></div>"
`;
