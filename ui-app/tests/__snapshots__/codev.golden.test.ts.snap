exports[`golden de transcript — missão completa > cenário a (corrigir E0382) em modo assistido, do pedido à entrega 1`] = `"<div class="m user"><div class="bub"><div class="bh"><span class="br2">tu</span><span class="bt">11:00</span></div><div class="bd">Corrige o erro E0382 (use of moved value) em crates/lexer/src/lib.rs.</div></div></div><div class="phase"><i>1</i>Entender requisitos</div><div class="m ai"><div class="bub"><div class="bh"><span class="br2">planeador · claude</span><span class="bt">11:00</span></div><div class="bd"><p>O <code>for</code> move o iterador <code>chars</code>; a linha 10 volta a usá-lo. O objectivo é compilar sem mudar o comportamento.</p><div class="req"><b>O crate lexer compila</b><div class="ac"><code>cargo build</code> sem E0382</div></div><div class="req"><b>O comportamento mantém-se</b><div class="ac"><code>tokenize_emits_eof</code> continua a passar</div><div class="ac">a assinatura pública de <code>tokenize</code> não muda</div></div></div><div class="tools"><div class="tool"><span class="tn">read_file</span><span class="ta">.dxtutor/regras.md</span><span class="tr"><span class="okc">✓</span></span></div><div class="tool"><span class="tn">read_file</span><span class="ta">crates/lexer/src/lib.rs</span><span class="tr"><span class="okc">✓</span></span></div></div></div></div><div class="phase"><i>2</i>Clarificar</div><div class="m ai"><div class="bub"><div class="bh"><span class="br2">planeador · claude</span><span class="bt">11:00</span></div><div class="bd"><p><b>Posso alterar a assinatura pública de tokenize()?</b></p><div class="qo"><div class="qopt pick" data-i="0"><span class="ql">Não — manter a API<small>a correcção é interna à função</small></span><span class="tag acc">recomendada · 97%</span></div><div class="qopt dim" data-i="1"><span class="ql">Sim — devolver um iterador<small>mais idiomático, mas quebra quem usa o crate</small></span></div></div><div class="qfoot"><span class="tag acc">decidido pelo Co-Dev</span><span>base: regras.md §2</span></div></div><div class="tools"></div></div></div><div class="phase"><i>3</i>Conselho de modelos</div><div class="m ai"><div class="bub"><div class="bh"><span class="br2">juiz · claude</span><span class="bt">11:00</span></div><div class="bd"><p>Pedi uma proposta a cada provedor ligado (3) e avalio-as às cegas com a mesma rubrica.</p><div class="cl"><div class="cand best"><div class="ch"><span class="pdot" style="background:var(--accent-hover)"></span>Proposta A · Claude<span class="tot">94.0</span></div><div class="ct">Emprestar o iterador com by_ref()</div><div class="cs">Uma linha alterada: o ciclo consome o iterador por referência e ele continua válido para o peek() final.</div><div class="crit"><span>Corr.<i><b style="width:100%"></b></i></span><span>Arq.<i><b style="width:90%"></b></i></span><span>Testes<i><b style="width:90%"></b></i></span><span>Risco<i><b style="width:90%"></b></i></span><span>Custo<i><b style="width:100%"></b></i></span></div></div><div class="cand"><div class="ch"><span class="pdot" style="background:var(--green)"></span>Proposta B · Codex<span class="tot">88.0</span></div><div class="ct">Reescrever com while let</div><div class="cs">Ciclo explícito com chars.next(). Correcto, mas menos directo de rever.</div><div class="crit"><span>Corr.<i><b style="width:100%"></b></i></span><span>Arq.<i><b style="width:80%"></b></i></span><span>Testes<i><b style="width:90%"></b></i></span><span>Risco<i><b style="width:80%"></b></i></span><span>Custo<i><b style="width:80%"></b></i></span></div></div><div class="cand"><div class="ch"><span class="pdot" style="background:var(--purple)"></span>Proposta C · Ollama<span class="tot">45.5</span></div><div class="ct">Clonar o iterador</div><div class="cs">Compila, mas o original fica por consumir: o peek() final deixa de detectar o fim da entrada.</div><div class="crit"><span>Corr.<i><b style="width:40%"></b></i></span><span>Arq.<i><b style="width:50%"></b></i></span><span>Testes<i><b style="width:30%"></b></i></span><span>Risco<i><b style="width:40%"></b></i></span><span>Custo<i><b style="width:90%"></b></i></span></div></div></div><div class="qfoot"><span class="tag acc">decidido pelo juiz</span><span>rubrica: Correcção 30 · Arquitectura 25 · Testes 20 · Risco 15 · Custo 10</span></div></div><div class="tools"></div></div></div><div class="phase"><i>4</i>Planear e executar</div><div class="m ai"><div class="bub"><div class="bh"><span class="br2">programador · codex</span><span class="bt">11:00</span></div><div class="bd"><div class="plan" style="margin:0"><div class="plan-h"><span class="plan-t">Plano · Emprestar o iterador com by_ref()</span><span class="plan-c">2/2</span></div><div class="bar"><span style="width: 100%;"></span></div><div class="stp done"><span class="g">✓</span><span class="l">Ler lib.rs e o erro do compilador</span><span class="d">0.5s</span></div><div class="stp done"><span class="g">✓</span><span class="l">Aplicar by_ref() no ciclo</span><span class="d">0.7s</span></div></div></div><div class="tools"><div class="tool"><span class="tn">read_file</span><span class="ta">crates/lexer/src/lib.rs</span><span class="tr"><span class="okc">✓</span></span></div><div class="tool"><span class="tn">edit_file</span><span class="ta">crates/lexer/src/lib.rs</span><span class="tr"><span class="pls">+1</span><span class="mns">−1</span><button class="lnk">ver diff</button></span></div></div></div></div><div class="phase"><i>6</i>Verificar e auto-avaliar</div><div class="m ai"><div class="bub"><div class="bh"><span class="br2">revisor · gemini</span><span class="bt">11:00</span></div><div class="bd"><p>Corro os testes e o lint e pontuo o resultado contra os critérios — quem revê não é quem escreveu.</p><div class="evalbox"><div class="score ok">100<small>/100</small></div><div style="flex:1;min-width:0"><div class="chk ok"><span class="g">✓</span><span>O crate compila sem E0382</span><span class="w">40</span></div><div class="chk ok"><span class="g">✓</span><span>Testes do lexer passam (incl. tokenize_emits_eof)</span><span class="w">40</span></div><div class="chk ok"><span class="g">✓</span><span>Alteração mínima e API pública intacta</span><span class="w">20</span></div></div></div><div class="qfoot"><span class="tag live">acima do limiar 85</span></div></div><div class="tools"><div class="tool"><span class="tn">$</span><span class="ta">cargo test -p lexer</span><span class="tr"><span class="okc">✓ 2 passados · 0 falhados</span></span></div></div></div></div><div class="phase"><i>8</i>Entregar</div><div class="m ai"><div class="bub"><div class="bh"><span class="br2">planeador · claude</span><span class="bt">11:00</span></div><div class="bd"><p><b>Corrigir E0382 no lexer</b> — concluído com auto-avaliação <b style="color:var(--green)">100/100</b>.</p><ul><li><code>lib.rs</code>: o ciclo passa a emprestar o iterador</li><li><code>cargo test -p lexer</code>: 2 passados</li></ul><p style="color:var(--fg-dim)">2 decisões registadas · 1 ficheiro(s) alterado(s).</p><div class="gate"><button class="gb">Ver alterações</button><button class="gb">Registo de decisões</button></div><div class="gate"><span class="gdone">✓ commit aprovado por ti</span></div><p>Commit <code>1f9add3</code> feito: <code>fix(lexer): borrow the iterator in the loop (E0382)</code>. O <code>git push</code> fica contigo — exige sempre aprovação humana.</p><div class="gate"><span class="gdone">✓ merge aprovado por ti</span></div><p>Gitflow: <code>fix/e0382-lexer</code> → <code>develop</code> (merge <code>1f9add3</code>), ramo apagado. A release para <code>main</code> fica sempre contigo.</p></div><div class="tools"></div></div></div>"`;

exports[`goldens de DOM — estados estáticos > #pane-codev (missões, conhecimento, checkpoints, routing, equipa, backlog, studio) 1`] = `
"<div class="side-hd"><span class="t">Co-Dev</span><span class="acts"><button title="Gestor de missões"><svg class="ico" viewBox="0 0 16 16"><circle cx="4" cy="4" r="1.6"></circle><circle cx="4" cy="12" r="1.6"></circle><circle cx="12" cy="8" r="1.6"></circle><path d="M4 5.6v4.8M5.4 4.8l5.2 2.5M5.4 11.2l5.2-2.5"></path></svg></button><button title="Definições"><svg class="ico" viewBox="0 0 16 16"><circle cx="8" cy="8" r="2.1"></circle><path d="M8 1.6v1.8M8 12.6v1.8M1.6 8h1.8M12.6 8h1.8M3.5 3.5l1.3 1.3M11.2 11.2l1.3 1.3M12.5 3.5l-1.3 1.3M4.8 11.2l-1.3 1.3"></path></svg></button></span></div><div class="sections"><div class="scm-grp">Equipa<span class="cnt">8</span></div><div class="scm-row" title="Orquestrador: decompõe, delega e integra"><span class="pdot" style="background:var(--accent)"></span><span class="nm">Co-Dev</span><span class="pth">**</span></div><div class="scm-row" title="Requisitos, arquitectura, ADRs e backlog"><span class="pdot" style="background:var(--accent-hover)"></span><span class="nm">Arquitecto</span><span class="pth">.dxtutor/**, docs/**</span></div><div class="scm-row" title="Crates Rust e comandos Tauri"><span class="pdot" style="background:#dea584"></span><span class="nm">Backend</span><span class="pth">crates/**, apps/*/src/**, apps/*/Cargo.toml, apps/*/go.mod, apps/*/package.json, apps/*/requirements.txt</span></div><div class="scm-row" title="Esquema, migrações e índices"><span class="pdot" style="background:var(--green)"></span><span class="nm">Base de dados</span><span class="pth">db/migrations/**</span></div><div class="scm-row" title="Interface e Design System"><span class="pdot" style="background:var(--blue)"></span><span class="nm">Frontend</span><span class="pth">desktop/src/**, web/**</span></div><div class="scm-row" title="Testes automáticos"><span class="pdot" style="background:var(--yellow)"></span><span class="nm">QA</span><span class="pth">crates/*/tests/**, tests/**</span></div><div class="scm-row" title="Infra, CI/CD e deploy"><span class="pdot" style="background:var(--purple)"></span><span class="nm">Plataforma</span><span class="pth">docker-compose.yml, .env.example, Makefile, apps/*/Dockerfile, deploy/**, .ci/**, Cargo.toml</span></div><div class="scm-row" title="Explica e orienta; nunca escreve por ti"><span class="pdot" style="background:var(--cyan)"></span><span class="nm">Tutor</span><span class="pth">só leitura</span></div><div class="scm-grp">Backlog<span class="cnt">0</span></div><div class="scm-row"><span class="ic"><svg class="ico" viewBox="0 0 16 16"><rect x="2" y="2.5" width="12" height="11" rx="1.2"></rect><path d="M8 2.5v11"></path></svg></span><span class="nm">Quadro</span><span class="pth">0 · 0 · 0 · 0 · 0 · 0</span></div><div class="scm-row"><span class="ic"><svg class="ico" viewBox="0 0 16 16"><path d="M8 1.9l5.4 3v6.2L8 14.1l-5.4-3V4.9z"></path><path d="M8 7.9l5.4-3M8 7.9v6.2M8 7.9L2.6 4.9"></path></svg></span><span class="nm">Studio</span><span class="pth">8 planeados</span></div>
   <div class="scm-grp">Missões<span class="cnt">0</span></div><div class="sec-empty">Ainda sem missões. Experimenta uma das demonstrações no painel do Co-Dev.</div>
   <div class="scm-grp">Conhecimento do projecto<span class="cnt">7</span></div><div class="scm-row"><span class="ic x-md"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span class="nm" style="max-width:none">ADR-001-local-first</span></div><div class="scm-row"><span class="ic x-md"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span class="nm" style="max-width:none">ADR-002-camadas</span></div><div class="scm-row"><span class="ic x-md"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span class="nm" style="max-width:none">base-de-dados</span></div><div class="scm-row"><span class="ic x-md"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span class="nm" style="max-width:none">design-system</span></div><div class="scm-row"><span class="ic x-md"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span class="nm" style="max-width:none">padroes</span></div><div class="scm-row"><span class="ic x-md"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span class="nm" style="max-width:none">regras</span></div><div class="scm-row"><span class="ic x-md"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span class="nm" style="max-width:none">requisitos</span></div>
   <div class="scm-grp">Checkpoints<span class="cnt">0</span></div><div class="sec-empty">Criados automaticamente antes de cada missão e de cada correcção.</div>
   <div class="scm-grp">Routing</div><div class="kv"><span class="pdot" style="background:var(--accent-hover)"></span>Planeador<span class="v">Claude</span></div><div class="kv"><span class="pdot" style="background:var(--green)"></span>Programador<span class="v">Codex</span></div><div class="kv"><span class="pdot" style="background:var(--blue)"></span>Revisor<span class="v">Gemini</span></div><div class="kv"><span class="pdot" style="background:var(--accent-hover)"></span>Juiz<span class="v">Claude</span></div><div class="kv"><span class="pdot" style="background:var(--purple)"></span>Privado / offline<span class="v">Ollama</span></div></div>"
`;

exports[`goldens de DOM — estados estáticos > chat depois de newChat() 1`] = `
"<div class="intro" id="ag-intro"><div class="i-t">Co-Dev</div><div class="i-s">Entendo requisitos, proponho arquitectura, escrevo, testo, avalio o meu próprio trabalho e corrijo-o — contigo a orientar.</div>
  <button class="chip"><b>Histórico de conversas persistente</b><small>Requisitos → BD → Repository → UI → testes. Inclui uma auto-correcção.</small></button>
  <button class="chip"><b>Corrigir o E0382 em lib.rs</b><small>Três provedores propõem; o juiz escolhe a melhor.</small></button>
  <button class="chip"><b>Explica o ficheiro activo</b><small>Pergunta livre — respondida pelo Claude ao vivo.</small></button>
  <div class="i-n" id="live-note"><span class="tag">simulado</span> nesta vista as missões são guionadas; a ligação ao vivo ao Claude activa-se quando o artefacto é aberto em claude.ai.</div></div>"
`;

exports[`goldens de DOM — estados estáticos > página Bem-vindo (renderWelcomePage) 1`] = `
"<div class="page"><div style="display:flex;align-items:center;gap:14px;margin-bottom:8px"><div style="width:40px;height:40px;display:grid;place-items:center;background:var(--accent-grad);border-radius:11px;color:#fff;box-shadow:var(--sh-acc)"><svg class="ico" viewBox="0 0 16 16"><path d="M8 1.8l1.4 4L13.4 7l-4 1.2L8 12.2 6.6 8.2 2.6 7l4-1.2z" class="fill"></path></svg></div><h1 style="font-weight:300;font-size:26px;margin:0">dxtutor <b style="font-weight:600">IDE</b></h1></div>
  <div class="sub">Um IDE com um Co-Dev multi-modelo. Tudo aqui é navegável: os ficheiros editam-se, a pesquisa procura, o git faz commit, os testes reagem ao código — e o Co-Dev trabalha sobre esses mesmos ficheiros.</div>
  <h2>Ver o Co-Dev a trabalhar</h2><div class="wgrid"><button class="wbtn"><span class="wi"><svg class="ico" viewBox="0 0 16 16"><path d="M8 1.8l1.4 4L13.4 7l-4 1.2L8 12.2 6.6 8.2 2.6 7l4-1.2z" class="fill"></path></svg></span><span><b>Histórico de conversas</b><small>Missão completa, com auto-correcção</small></span></button><button class="wbtn"><span class="wi"><svg class="ico" viewBox="0 0 16 16"><circle cx="8" cy="8.8" r="3.4"></circle><path d="M8 5.4V3.2M5.2 6.4 3.8 5M10.8 6.4 12.2 5M4.6 8.8H2.6M13.4 8.8h-2M5.4 11.2 4 12.6M10.6 11.2 12 12.6"></path></svg></span><span><b>Corrigir o E0382</b><small>Conselho de 3 modelos + juiz</small></span></button><button class="wbtn"><span class="wi"><svg class="ico" viewBox="0 0 16 16"><circle cx="4" cy="4" r="1.6"></circle><circle cx="4" cy="12" r="1.6"></circle><circle cx="12" cy="8" r="1.6"></circle><path d="M4 5.6v4.8M5.4 4.8l5.2 2.5M5.4 11.2l5.2-2.5"></path></svg></span><span><b>Gestor de missões</b><small>Decisões, checkpoints e uso</small></span></button><button class="wbtn"><span class="wi"><svg class="ico" viewBox="0 0 16 16"><circle cx="8" cy="8" r="2.1"></circle><path d="M8 1.6v1.8M8 12.6v1.8M1.6 8h1.8M12.6 8h1.8M3.5 3.5l1.3 1.3M11.2 11.2l1.3 1.3M12.5 3.5l-1.3 1.3M4.8 11.2l-1.3 1.3"></path></svg></span><span><b>Modelos e autonomia</b><small>Provedores, routing, modos</small></span></button></div>
  <h2>Navegar</h2><div class="wgrid"><button class="wbtn"><span class="wi"><svg class="ico" viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.1"></circle><path d="M10 10l3.6 3.6"></path></svg></span><span><b>Ir para ficheiro</b><small>Ctrl+P</small></span></button><button class="wbtn"><span class="wi"><svg class="ico" viewBox="0 0 16 16"><path d="M5 3.4v9.2l7-4.6z"></path></svg></span><span><b>Todos os comandos</b><small>Ctrl+Shift+P</small></span></button><button class="wbtn"><span class="wi"><svg class="ico" viewBox="0 0 16 16"><path d="M3 3.2h4.5a1.5 1.5 0 0 1 1.5 1.5v8.1a1.2 1.2 0 0 0-1.2-1.2H3z"></path><path d="M13 3.2H8.5A1.5 1.5 0 0 0 7 4.7v8.1a1.2 1.2 0 0 1 1.2-1.2H13z"></path></svg></span><span><b>O que mudou e porquê</b><small>Análise face a VS Code, Antigravity e Claude Desktop</small></span></button><button class="wbtn"><span class="wi"><svg class="ico" viewBox="0 0 16 16"><rect x="5.2" y="2.3" width="7" height="9.3" rx="1"></rect><path d="M5.2 4.6H3.8a1 1 0 0 0-1 1v7.1a1 1 0 0 0 1 1h5.9a1 1 0 0 0 1-1v-1.1"></path></svg></span><span><b>Conhecimento do projecto</b><small>Regras, ADRs, Design System, BD</small></span></button></div></div>"
`;

exports[`goldens de DOM — estados estáticos > página Definições (renderSettingsPage) 1`] = `
"<div class="page"><h1>Definições</h1><div class="sub">Guardadas neste browser. Chaves e endpoints reais ficam no keychain da aplicação — aqui servem para mostrar o contrato.</div>
  <h2>Modelos e provedores</h2><div class="pgrid"><div class="pcard"><div class="ph"><span class="pdot" style="background:var(--accent-hover)"></span>Claude<span class="tag ">ao vivo indisponível aqui</span><button class="sw on" title="Ligar / desligar"></button></div>
    <div><label>Modelo</label><input value="claude-opus-5-5"></div><div><label>Endpoint</label><input value="https://api.anthropic.com"></div>
    <div><label>Chave de API</label><input type="password" placeholder="guardada no keychain"></div><button class="mini">Testar ligação</button><div class="pd"></div></div><div class="pcard"><div class="ph"><span class="pdot" style="background:var(--blue)"></span>Gemini<span class="tag ">simulado</span><button class="sw on" title="Ligar / desligar"></button></div>
    <div><label>Modelo</label><input value="gemini-pro"></div><div><label>Endpoint</label><input value="https://generativelanguage.googleapis.com"></div>
    <div><label>Chave de API</label><input type="password" placeholder="guardada no keychain"></div><button class="mini">Testar ligação</button><div class="pd"></div></div><div class="pcard"><div class="ph"><span class="pdot" style="background:var(--green)"></span>Codex<span class="tag ">simulado</span><button class="sw on" title="Ligar / desligar"></button></div>
    <div><label>Modelo</label><input value="gpt-codex"></div><div><label>Endpoint</label><input value="https://api.openai.com"></div>
    <div><label>Chave de API</label><input type="password" placeholder="guardada no keychain"></div><button class="mini">Testar ligação</button><div class="pd"></div></div><div class="pcard"><div class="ph"><span class="pdot" style="background:var(--purple)"></span>Ollama<span class="tag ">local · simulado</span><button class="sw on" title="Ligar / desligar"></button></div>
    <div><label>Modelo</label><input value="qwen2.5-coder:14b"></div><div><label>Endpoint</label><input value="http://localhost:11434"></div>
    <div><label>Chave (não é necessária)</label><input type="password" placeholder="—" disabled=""></div><button class="mini">Testar ligação</button><div class="pd"></div></div></div>
  <h2>Routing por papel</h2><div class="tbl-wrap"><div class="rowline"><span class="pdot" style="background:var(--accent-hover)"></span><b>Planeador</b><span style="color:var(--fg-muted)">requisitos, arquitectura, plano</span><span class="sp"></span><select style="width:150px"><option value="claude" selected="">Claude</option><option value="gemini">Gemini</option><option value="codex">Codex</option><option value="ollama">Ollama</option></select></div><div class="rowline"><span class="pdot" style="background:var(--green)"></span><b>Programador</b><span style="color:var(--fg-muted)">escreve e edita código</span><span class="sp"></span><select style="width:150px"><option value="claude">Claude</option><option value="gemini">Gemini</option><option value="codex" selected="">Codex</option><option value="ollama">Ollama</option></select></div><div class="rowline"><span class="pdot" style="background:var(--blue)"></span><b>Revisor</b><span style="color:var(--fg-muted)">testes, lint, auto-avaliação</span><span class="sp"></span><select style="width:150px"><option value="claude">Claude</option><option value="gemini" selected="">Gemini</option><option value="codex">Codex</option><option value="ollama">Ollama</option></select></div><div class="rowline"><span class="pdot" style="background:var(--accent-hover)"></span><b>Juiz</b><span style="color:var(--fg-muted)">escolhe entre propostas</span><span class="sp"></span><select style="width:150px"><option value="claude" selected="">Claude</option><option value="gemini">Gemini</option><option value="codex">Codex</option><option value="ollama">Ollama</option></select></div><div class="rowline"><span class="pdot" style="background:var(--purple)"></span><b>Privado / offline</b><span style="color:var(--fg-muted)">autocomplete e dados sensíveis</span><span class="sp"></span><select style="width:150px"><option value="claude">Claude</option><option value="gemini">Gemini</option><option value="codex">Codex</option><option value="ollama" selected="">Ollama</option></select></div></div><div class="sub" style="margin-top:8px">Se o provedor de um papel estiver desligado, o Co-Dev recorre ao primeiro que estiver ligado.</div>
  <h2>Autonomia</h2><div class="pgrid"><button class="pcard"><div class="ph">Manual</div><div class="pd">Tu decides tudo: respostas, proposta, plano, cada edição e cada comando.</div></button><button class="pcard sel"><div class="ph">Assistido<span class="tag acc">activo</span></div><div class="pd">O Co-Dev decide o que é seguro e reversível; pergunta-te quando a confiança é baixa.</div></button><button class="pcard"><div class="ph">Auto</div><div class="pd">Autónomo de ponta a ponta, com auto-avaliação e correcção. Só pára para push e acções destrutivas.</div></button></div>
  <div class="tbl-wrap" style="margin-top:10px"><table class="tbl"><tbody><tr><th>Acção</th><th>Manual</th><th>Assistido</th><th>Auto</th></tr><tr><td>Responder a perguntas de clarificação</td><td class="c">tu</td><td class="on">Co-Dev se confiança ≥ 80%; senão pergunta</td><td class="c">Co-Dev; abaixo de 80% assume a opção reversível e assinala</td></tr><tr><td>Escolher entre propostas dos modelos</td><td class="c">tu, com recomendação do juiz</td><td class="on">juiz</td><td class="c">juiz</td></tr><tr><td>Aprovar o plano</td><td class="c">tu</td><td class="on">automático</td><td class="c">automático</td></tr><tr><td>Editar ficheiros</td><td class="c">aprovas cada edição</td><td class="on">automático, com diff</td><td class="c">automático, com diff</td></tr><tr><td>Terminal: testes, build, lint</td><td class="c">aprovas</td><td class="on">automático</td><td class="c">automático</td></tr><tr><td>Terminal: outros comandos</td><td class="c">aprovas</td><td class="on">aprovas</td><td class="c">automático</td></tr><tr><td>Corrigir depois de falhar a auto-avaliação</td><td class="c">aprovas</td><td class="on">automático (máx. 2)</td><td class="c">automático (máx. 2)</td></tr><tr><td>Commit local</td><td class="c">aprovas</td><td class="on">aprovas</td><td class="c">automático</td></tr><tr><td>Push e acções destrutivas</td><td class="c">aprovas</td><td class="on">aprovas</td><td class="c">aprovas — sempre</td></tr></tbody></table></div>
  <h2>Auto-avaliação</h2><div class="tbl-wrap"><div class="rowline"><b>Limiar para entregar</b><span style="color:var(--fg-muted)">abaixo disto o Co-Dev corrige em vez de entregar</span><span class="sp"></span><input type="range" min="50" max="100" step="5" value="85" style="width:140px"><b style="width:28px;text-align:right">85</b></div><div class="rowline"><b>Tentativas de correcção</b><span class="sp"></span><span>2, depois pede orientação</span></div><div class="rowline"><b>Rubrica do juiz</b><span class="sp"></span><span>Correcção 30 · Arquitectura 25 · Testes 20 · Risco 15 · Custo 10</span></div></div>
  <h2>Aparência</h2><div class="pgrid"><button class="pcard sel"><div class="ph">Grafite laranja<span class="tag acc">activo</span></div></button><button class="pcard"><div class="ph">Slate índigo</div></button><button class="pcard"><div class="ph">Papel claro</div></button></div>
  <h2>Atalhos de teclado</h2><div class="tbl-wrap"><div class="rowline"><span>Ir para ficheiro…</span><span class="sp"></span><kbd>Ctrl+P</kbd></div><div class="rowline"><span>Mostrar todos os comandos</span><span class="sp"></span><kbd>Ctrl+Shift+P</kbd></div><div class="rowline"><span>Ir para a linha…</span><span class="sp"></span><kbd>Ctrl+G</kbd></div><div class="rowline"><span>Ir para o próximo problema</span><span class="sp"></span><kbd>F8</kbd></div><div class="rowline"><span>Ver: Explorer</span><span class="sp"></span><kbd>Ctrl+Shift+E</kbd></div><div class="rowline"><span>Ver: Pesquisa</span><span class="sp"></span><kbd>Ctrl+Shift+F</kbd></div><div class="rowline"><span>Ver: Source Control</span><span class="sp"></span><kbd>Ctrl+Shift+G</kbd></div><div class="rowline"><span>Ver: Alternar barra lateral</span><span class="sp"></span><kbd>Ctrl+B</kbd></div><div class="rowline"><span>Ver: Alternar painel</span><span class="sp"></span><kbd>Ctrl+J</kbd></div><div class="rowline"><span>Ver: Terminal</span><span class="sp"></span><kbd>Ctrl+\`</kbd></div><div class="rowline"><span>Ver: Problemas</span><span class="sp"></span><kbd>Ctrl+Shift+M</kbd></div><div class="rowline"><span>Co-Dev: Focar a conversa</span><span class="sp"></span><kbd>Ctrl+L</kbd></div><div class="rowline"><span>Co-Dev: Painel de conhecimento</span><span class="sp"></span><kbd>Ctrl+Shift+A</kbd></div><div class="rowline"><span>Preferências: Definições</span><span class="sp"></span><kbd>Ctrl+,</kbd></div></div></div>"
`;

exports[`goldens de DOM — estados estáticos > página Gestor de missões (renderManagerPage, estado inicial) 1`] = `
"<div class="page"><h1>Gestor de missões</h1><div class="sub">Tudo o que o Co-Dev fez, decidiu e pode desfazer.</div>
  <h2>Missões</h2><div class="tbl-wrap"><div class="rowline" style="color:var(--fg-muted)">Ainda sem missões.<span class="sp"></span><button class="mini">Correr a demonstração</button></div></div>
  <h2>Registo de decisões</h2><div class="tbl-wrap"><table class="tbl"><tbody><tr><th>#</th><th>Fase</th><th>Decisão</th><th>Escolha</th><th>Quem</th><th>Confiança</th><th>Estado</th></tr><tr><td colspan="7" class="c">Sem decisões registadas.</td></tr></tbody></table></div>
  <h2>Checkpoints</h2><div class="tbl-wrap"><div class="rowline" style="color:var(--fg-muted)">Criados antes de cada missão e de cada correcção.</div></div>
  <h2>Uso por provedor <span style="text-transform:none;letter-spacing:0;font-weight:400">(estimativa)</span></h2><div class="tbl-wrap"><div class="rowline"><span class="pdot" style="background:var(--accent-hover)"></span><b>Claude</b><span style="color:var(--fg-muted)">Planeador, Juiz</span><span class="sp"></span><span>0 chamadas · 0.0k tokens</span></div><div class="rowline"><span class="pdot" style="background:var(--blue)"></span><b>Gemini</b><span style="color:var(--fg-muted)">Revisor</span><span class="sp"></span><span>0 chamadas · 0.0k tokens</span></div><div class="rowline"><span class="pdot" style="background:var(--green)"></span><b>Codex</b><span style="color:var(--fg-muted)">Programador</span><span class="sp"></span><span>0 chamadas · 0.0k tokens</span></div><div class="rowline"><span class="pdot" style="background:var(--purple)"></span><b>Ollama</b><span style="color:var(--fg-muted)">Privado / offline</span><span class="sp"></span><span>0 chamadas · 0.0k tokens</span></div></div></div>"
`;
