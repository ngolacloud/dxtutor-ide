// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sem repositório git > golden + dispatch: no desktop com pasta sem git, o pane oferece \`git init\` > pane-no-repo-folder 1`] = `"<div class="side-hd"><span class="t">Source Control</span><span class="acts"></span></div><div class="sections"><div class="sec-empty">Esta pasta não é um repositório git. Os commits, os ramos, o gitflow e o grafo usam o git real da pasta.</div><button class="btn">git init</button></div>"`;

exports[`sem repositório git > golden: no browser, o pane diz que não há repositório (sem lista de ramos/commits) > pane-no-repo-browser 1`] = `"<div class="side-hd"><span class="t">Source Control</span><span class="acts"></span></div><div class="sections"><div class="sec-empty">Nenhum repositório git aberto. O controlo de versões usa o git real da pasta aberta na app desktop.</div></div>"`;
