// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sem repositório git > golden + dispatch: no desktop com pasta sem git, o pane oferece \`git init\` > pane-no-repo-folder 1`] = `"<div class="side-hd"><span class="t">Source Control</span><span class="acts"></span></div><div class="sections"><div class="sec-empty">This folder is not a git repository. Commits, branches, gitflow and the graph use the folder's real git.</div><button class="btn">git init</button></div>"`;

exports[`sem repositório git > golden: no browser, o pane diz que não há repositório (sem lista de ramos/commits) > pane-no-repo-browser 1`] = `"<div class="side-hd"><span class="t">Source Control</span><span class="acts"></span></div><div class="sections"><div class="sec-empty">No git repository open. Version control uses the real git of the folder open in the desktop app.</div></div>"`;
