exports[`visualizer · motor puro — narração > vzTell narra cada passo do exemplo \`sum\` (povoado por vizOpen em VZ.notes) 1`] = `
{
  "0": [
    {
      "i": [
        "start",
        "Every <b>stack frame</b> holds the local variables of one call. Heap memory is separate and is only used when something asks for it (a Vec, a String, a Box).",
      ],
      "k": "start",
      "m": "Before main, the Rust runtime (<code>std::rt::lang_start</code>) installs a stack-overflow guard page and the panic handler.",
      "t": "The process starts: the runtime sets up the main thread and calls <code>main</code>. Its stack frame is the first one.",
    },
  ],
  "1": [
    {
      "i": [
        "arr",
        "An array lives <b>inline on the stack</b>: all 40 bytes sit in the frame, no heap allocation. Its size is part of its type.",
      ],
      "k": "bind",
      "m": "Stored at <code>0x7ffd3a1c8fd8</code>, 40 bytes below the previous slot. The compiler fixes these offsets at compile time; nothing is “allocated” at run time for stack slots.",
      "t": "<code>values</code> = <code>[4, 8, 15, 16, 23]</code> — a <code>[i64; 5]</code> taking 40 bytes on the stack.",
    },
  ],
  "10": [
    {
      "i": null,
      "k": "iter",
      "m": "The slice iterator is two pointers (current, end). Each step: compare, load 8 bytes, advance by 8. <code>n</code> is a reference into the original memory.",
      "t": "Next element of <code>values</code>: <code>n</code> = <code>&amp;16</code> (item 4 of 5).",
    },
  ],
  "11": [
    {
      "k": "ovf",
      "m": "Debug builds check every arithmetic operation and panic on overflow; release builds wrap silently unless <code>overflow-checks = true</code>.",
      "t": "Overflow check on <code>+</code> for <code>i64</code>.",
    },
    {
      "k": "set",
      "t": "<code>total</code> = <code>43</code>",
    },
  ],
  "12": [
    {
      "i": null,
      "k": "iter",
      "m": "The slice iterator is two pointers (current, end). Each step: compare, load 8 bytes, advance by 8. <code>n</code> is a reference into the original memory.",
      "t": "Next element of <code>values</code>: <code>n</code> = <code>&amp;23</code> (item 5 of 5).",
    },
  ],
  "13": [
    {
      "k": "ovf",
      "m": "Debug builds check every arithmetic operation and panic on overflow; release builds wrap silently unless <code>overflow-checks = true</code>.",
      "t": "Overflow check on <code>+</code> for <code>i64</code>.",
    },
    {
      "k": "set",
      "t": "<code>total</code> = <code>66</code>",
    },
  ],
  "14": [
    {
      "k": "cond",
      "m": null,
      "t": "The iterator is exhausted: the loop ends.",
    },
  ],
  "15": [
    {
      "k": "ret",
      "m": "The value travels back in <code>rax</code>; <code>ret</code> pops the return address and jumps back.",
      "t": "<code>sum_list</code> returns <code>66</code> to <code>main</code>; its frame is popped.",
    },
  ],
  "16": [
    {
      "i": null,
      "k": "bind",
      "m": "Stored at <code>0x7ffd3a1c8fd0</code>, 8 bytes below the previous slot. The compiler fixes these offsets at compile time; nothing is “allocated” at run time for stack slots.",
      "t": "<code>result</code> = <code>66</code> — a <code>i64</code> taking 8 bytes on the stack.",
    },
  ],
  "17": [
    {
      "i": [
        "print",
        "Printing goes through the kernel (a <b>system call</b>), which is thousands of times slower than arithmetic. Printing inside hot loops dominates run time.",
      ],
      "k": "print",
      "m": "stdout is line-buffered: the formatted text goes into a buffer; the newline flushes it with one <code>write(1, …)</code> system call.",
      "t": "Prints 9 bytes to stdout.",
    },
  ],
  "18": [
    {
      "k": "exit",
      "m": "<code>exit_group(0)</code>: the kernel reclaims the stack and any heap left (there is none here unless something leaked).",
      "t": "main returns: remaining values are dropped and the process exits with code 0.",
    },
  ],
  "2": [
    {
      "i": [
        "borrow",
        "<b>Borrowing</b> lets code read a value without taking ownership. Many shared borrows may coexist; none may mutate.",
      ],
      "k": "borrow",
      "m": "A slice reference carries its length with it; that is what makes bounds-checked indexing possible without knowing the array type.",
      "t": "<code>numbers</code> borrows <code>values</code> — a 16-byte <b>fat pointer</b> (address + length). No data copied.",
    },
    {
      "i": [
        "call",
        "A function call costs a frame on the stack. Small functions are often <b>inlined</b> by the optimiser and the frame disappears in release builds.",
      ],
      "k": "call",
      "m": "Arguments, typically (x86-64): <code>numbers</code> → rdi + rsi. The <code>call</code> instruction pushes the return address; the callee moves <code>rsp</code> down to make room for its locals. (The Rust ABI is unspecified; this is what rustc usually emits.)",
      "t": "Call <code>sum_list(numbers)</code>: a new stack frame is pushed (depth 2).",
    },
  ],
  "3": [
    {
      "i": [
        "int",
        "Integers are <b>Copy</b>: assigning or passing one copies the bits. ",
      ],
      "k": "bind",
      "m": "Stored at <code>0x7ffd3a1c8fb0</code>, 8 bytes below the previous slot. The compiler fixes these offsets at compile time; nothing is “allocated” at run time for stack slots.",
      "t": "<code>total</code> = <code>0</code> — a <code>i64</code> taking 8 bytes on the stack.",
    },
  ],
  "4": [
    {
      "i": [
        "iterslice",
        "Iterating a slice yields <b>references</b> — <code>n</code> points into <code>values</code>, nothing is copied — and needs <b>no bounds checks</b>.",
      ],
      "k": "iter",
      "m": "The slice iterator is two pointers (current, end). Each step: compare, load 8 bytes, advance by 8. <code>n</code> is a reference into the original memory.",
      "t": "Next element of <code>values</code>: <code>n</code> = <code>&amp;4</code> (item 1 of 5).",
    },
  ],
  "5": [
    {
      "k": "ovf",
      "m": "Debug builds check every arithmetic operation and panic on overflow; release builds wrap silently unless <code>overflow-checks = true</code>.",
      "t": "Overflow check on <code>+</code> for <code>i64</code>.",
    },
    {
      "k": "set",
      "t": "<code>total</code> = <code>4</code>",
    },
  ],
  "6": [
    {
      "i": null,
      "k": "iter",
      "m": "The slice iterator is two pointers (current, end). Each step: compare, load 8 bytes, advance by 8. <code>n</code> is a reference into the original memory.",
      "t": "Next element of <code>values</code>: <code>n</code> = <code>&amp;8</code> (item 2 of 5).",
    },
  ],
  "7": [
    {
      "k": "ovf",
      "m": "Debug builds check every arithmetic operation and panic on overflow; release builds wrap silently unless <code>overflow-checks = true</code>.",
      "t": "Overflow check on <code>+</code> for <code>i64</code>.",
    },
    {
      "k": "set",
      "t": "<code>total</code> = <code>12</code>",
    },
  ],
  "8": [
    {
      "i": null,
      "k": "iter",
      "m": "The slice iterator is two pointers (current, end). Each step: compare, load 8 bytes, advance by 8. <code>n</code> is a reference into the original memory.",
      "t": "Next element of <code>values</code>: <code>n</code> = <code>&amp;15</code> (item 3 of 5).",
    },
  ],
  "9": [
    {
      "k": "ovf",
      "m": "Debug builds check every arithmetic operation and panic on overflow; release builds wrap silently unless <code>overflow-checks = true</code>.",
      "t": "Overflow check on <code>+</code> for <code>i64</code>.",
    },
    {
      "k": "set",
      "t": "<code>total</code> = <code>27</code>",
    },
  ],
}
`;

exports[`visualizer · overlay #viz (golden) > avança o exemplo \`sum\` até ao último passo (saída + contadores) 1`] = `
"<div class="vz-box"><div class="vz-top"><svg class="ico" viewBox="0 0 16 16"><rect x="2" y="2.5" width="12" height="11" rx="1.5"></rect><path d="M5 2.5v11M11 2.5v11M2 5.5h3M2 8h3M2 10.5h3M11 5.5h3M11 8h3M11 10.5h3"></path></svg><b>Visualize execution</b><span class="tag live">STEP BY STEP</span><select class="mini"><option value="sum" selected="">Slices and the stack</option><option value="grow">How a Vec grows</option><option value="own">Ownership: move, borrow, clone, drop</option><option value="rec">Recursion and stack frames</option><option value="bounds">Bounds checks and panics</option><option value="ovf">Integer overflow</option><option value="str">Strings: rodata, heap and UTF-8</option><option value="moved">A use after move (compile error)</option></select><div class="seg vz-depth"><button class="">Basic</button><button class="on">Memory</button><button class="">Machine</button></div><label class="vz-pl"><input type="checkbox"> Predict mode</label><span class="sp"></span><button class="vz-x" title="Close (Esc)">×</button></div>
   <div class="vz-bar"><button class="mini" title="Step back (←)">◀ Step back</button><button class="mini pri" title="Play / pause (Space)">▶ Play</button><button class="mini" title="Step (→)">Step ▶</button><span class="vz-sl">Speed<input type="range" min="1" max="10" value="5"></span><span class="vz-pg">19 / 19</span><div class="vz-prog"><i style="width:100%"></i></div></div>
   <div class="vz-main"><div class="vz-code" id="vz-code"><div class="vl" id="vl-1"><span class="va"></span><span class="vn">1</span><span class="vh" title="1 time(s) so far"><i style="width:16.666666666666664%"></i></span><span class="vc"><span class="kw">fn</span> <span class="fn">sum_list</span>(numbers: &amp;[i64]) -&gt; i64 {</span></div><div class="vl" id="vl-2"><span class="va"></span><span class="vn">2</span><span class="vh" title="1 time(s) so far"><i style="width:16.666666666666664%"></i></span><span class="vc">    <span class="kw">let</span> <span class="kw">mut</span> total = <span class="num">0</span>;</span></div><div class="vl" id="vl-3"><span class="va"></span><span class="vn">3</span><span class="vh" title="6 time(s) so far"><i style="width:100%"></i></span><span class="vc">    <span class="kw">for</span> n <span class="kw">in</span> numbers {</span></div><div class="vl" id="vl-4"><span class="va"></span><span class="vn">4</span><span class="vh" title="5 time(s) so far"><i style="width:83.33333333333334%"></i></span><span class="vc">        total = total + n;</span></div><div class="vl" id="vl-5"><span class="va"></span><span class="vn">5</span><span class="vh" title="0 time(s) so far"><i style="width:0%"></i></span><span class="vc">    }</span></div><div class="vl" id="vl-6"><span class="va"></span><span class="vn">6</span><span class="vh" title="1 time(s) so far"><i style="width:16.666666666666664%"></i></span><span class="vc">    total</span></div><div class="vl" id="vl-7"><span class="va"></span><span class="vn">7</span><span class="vh" title="0 time(s) so far"><i style="width:0%"></i></span><span class="vc">}</span></div><div class="vl" id="vl-8"><span class="va"></span><span class="vn">8</span><span class="vh" title="0 time(s) so far"><i style="width:0%"></i></span><span class="vc"> </span></div><div class="vl" id="vl-9"><span class="va"></span><span class="vn">9</span><span class="vh" title="1 time(s) so far"><i style="width:16.666666666666664%"></i></span><span class="vc"><span class="kw">fn</span> <span class="fn">main</span>() {</span></div><div class="vl" id="vl-10"><span class="va"></span><span class="vn">10</span><span class="vh" title="1 time(s) so far"><i style="width:16.666666666666664%"></i></span><span class="vc">    <span class="kw">let</span> values = [<span class="num">4</span>, <span class="num">8</span>, <span class="num">15</span>, <span class="num">16</span>, <span class="num">23</span>];</span></div><div class="vl" id="vl-11"><span class="va"></span><span class="vn">11</span><span class="vh" title="1 time(s) so far"><i style="width:16.666666666666664%"></i></span><span class="vc">    <span class="kw">let</span> result = <span class="fn">sum_list</span>(&amp;values);</span></div><div class="vl prev" id="vl-12"><span class="va"></span><span class="vn">12</span><span class="vh" title="1 time(s) so far"><i style="width:16.666666666666664%"></i></span><span class="vc">    <span class="mac">println!</span>(<span class="str">"sum = {}"</span>, result);</span></div><div class="vl cur" id="vl-13"><span class="va">▶</span><span class="vn">13</span><span class="vh" title="1 time(s) so far"><i style="width:16.666666666666664%"></i></span><span class="vc">}</span></div><div class="vl" id="vl-14"><span class="va"></span><span class="vn">14</span><span class="vh" title="0 time(s) so far"><i style="width:0%"></i></span><span class="vc"> </span></div></div><div class="vz-right" id="vz-right"><div class="vz-card"><div class="vz-h"><span class="vz-ln">step 19 · line 13</span><span class="vz-fn">in <b>main</b></span></div>
      
      
      <div class="vz-n">main returns: remaining values are dropped and the process exits with code 0.</div>
      
      <div class="vz-end ok">✓ Program finished normally.</div>
      <div class="vz-ask"><button class="mini">Ask why</button><div id="vz-askout"></div></div></div><div class="vz-mem" id="vz-mem"><svg id="vz-arrows"></svg><div class="vz-col"><div class="vz-t">Stack <span class="vz-mute">grows ↓</span></div><div class="vz-frame on"><div class="vz-fh"><b>main</b><span>line 13</span></div><div class="vz-slot" id="vs-0-0">
        <div class="vz-sh"><b>values</b><span class="ty">[i64; 5]</span><span class="ad">40 B</span></div>
        <div class="vz-cells"><span id="vs-0-0-0"><i>0</i>4</span><span id="vs-0-0-1"><i>1</i>8</span><span id="vs-0-0-2"><i>2</i>15</span><span id="vs-0-0-3"><i>3</i>16</span><span id="vs-0-0-4"><i>4</i>23</span></div>
        </div><div class="vz-slot" id="vs-0-1">
        <div class="vz-sh"><b>result</b><span class="ty">i64</span><span class="ad">8 B</span></div>
        <div class="vz-val">66</div>
        </div></div></div>
        <div class="vz-col"><div class="vz-t">Heap</div><div class="vz-mute" style="padding:6px 2px">Nothing on the heap.</div>
        </div></div><div class="vz-sec"><div class="vz-t">Output</div><pre class="vz-out">sum = 66
</pre></div></div></div>
   <div class="vz-foot"><svg class="ico" viewBox="0 0 16 16"><path d="M8 2l6 3.2-6 3.2-6-3.2z"></path><path d="M2 8.4l6 3.2 6-3.2M2 11.4l6 3.2 6-3.2"></path></svg> A model of a debug build, run in your browser: values and control flow are exact for this Rust subset; addresses are illustrative and the machine notes describe typical x86-64 output. The desktop app traces real binaries.</div></div>"
`;

