   <div class="vz-main"><div class="vz-code" id="vz-code"><div class="vl" id="vl-1"><span class="va"></span><span class="vn">1</span><span class="vh" title="0 time(s) so far"><i style="width:0%"></i></span><span class="vc"><span class="kw">fn</span> <span class="fn">consume</span>(v: <span class="ty">Vec</span>&lt;i32&gt;) -&gt; usize {</span></div><div class="vl" id="vl-2"><span class="va"></span><span class="vn">2</span><span class="vh" title="0 time(s) so far"><i style="width:0%"></i></span><span class="vc">    v.<span class="fn">len</span>()</span></div><div class="vl" id="vl-3"><span class="va"></span><span class="vn">3</span><span class="vh" title="0 time(s) so far"><i style="width:0%"></i></span><span class="vc">}</span></div><div class="vl" id="vl-4"><span class="va"></span><span class="vn">4</span><span class="vh" title="0 time(s) so far"><i style="width:0%"></i></span><span class="vc"> </span></div><div class="vl cur" id="vl-5"><span class="va">▶</span><span class="vn">5</span><span class="vh" title="1 time(s) so far"><i style="width:100%"></i></span><span class="vc"><span class="kw">fn</span> <span class="fn">main</span>() {</span></div><div class="vl" id="vl-6"><span class="va"></span><span class="vn">6</span><span class="vh" title="0 time(s) so far"><i style="width:0%"></i></span><span class="vc">    <span class="kw">let</span> data = <span class="mac">vec!</span>[<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>];</span></div><div class="vl" id="vl-7"><span class="va"></span><span class="vn">7</span><span class="vh" title="0 time(s) so far"><i style="width:0%"></i></span><span class="vc">    <span class="kw">let</span> n = <span class="fn">consume</span>(data);</span></div><div class="vl" id="vl-8"><span class="va"></span><span class="vn">8</span><span class="vh" title="0 time(s) so far"><i style="width:0%"></i></span><span class="vc">    <span class="mac">println!</span>(<span class="str">"{} {}"</span>, n, data.<span class="fn">len</span>());</span></div><div class="vl" id="vl-9"><span class="va"></span><span class="vn">9</span><span class="vh" title="0 time(s) so far"><i style="width:0%"></i></span><span class="vc">}</span></div><div class="vl" id="vl-10"><span class="va"></span><span class="vn">10</span><span class="vh" title="0 time(s) so far"><i style="width:0%"></i></span><span class="vc"> </span></div></div><div class="vz-right" id="vz-right"><div class="vz-card"><div class="vz-h"><span class="vz-ln">step 1 · line 5</span><span class="vz-fn">in <b>main</b></span></div>
      
      
