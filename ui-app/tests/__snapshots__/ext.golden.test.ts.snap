exports[`goldens de DOM — pane de extensões e tab de detalhe > #pane-ext (estado inicial: rust-analyzer instalado, recomendadas, Open VSX) 1`] = `
"<div class="side-hd"><span class="t">Extensions</span><span class="acts"><button title="Install from VSIX…"><svg class="ico" viewBox="0 0 16 16"><path d="M8 3v10M3 8h10"></path></svg></button></span></div><div class="sections"><input class="inp" id="ex-q" placeholder="Search extensions in Open VSX" value=""><input type="file" id="vsix-in" accept=".vsix" style="display:none">
   <div class="scm-grp">Installed<span class="cnt">1</span></div><div class="ex-row"><span class="ex-ic" style="background:hsl(188 45% 45%)">r</span><div class="ex-t"><b class="notr">rust-analyzer</b><small class="notr">Rust language support: diagnostics, completion, go to definition.</small><span class="notr">rust-lang · bundled</span></div></div>
   <div class="scm-grp">Recommended for this project<span class="cnt">7</span></div><div class="ex-row"><span class="ex-ic" style="background:hsl(321 45% 45%)">E</span><div class="ex-t"><b class="notr">Error Lens</b><small class="notr">Shows diagnostics inline at the end of the line.</small><span class="notr">usernamehw</span></div><button class="mini pri">Install</button></div><div class="ex-row"><span class="ex-ic" style="background:hsl(91 45% 45%)">P</span><div class="ex-t"><b class="notr">Prettier</b><small class="notr">Opinionated code formatter.</small><span class="notr">esbenp</span></div><button class="mini pri">Install</button></div><div class="ex-row"><span class="ex-ic" style="background:hsl(98 45% 45%)">G</span><div class="ex-t"><b class="notr">GitLens</b><small class="notr">Git blame, history and commit graph.</small><span class="notr">eamodio</span></div><button class="mini pri">Install</button></div><div class="ex-row"><span class="ex-ic" style="background:hsl(15 45% 45%)">T</span><div class="ex-t"><b class="notr">Todo Tree</b><small class="notr">Lists TODO and FIXME comments in a tree.</small><span class="notr">Gruntfuggly</span></div><button class="mini pri">Install</button></div><div class="ex-row"><span class="ex-ic" style="background:hsl(67 45% 45%)">E</span><div class="ex-t"><b class="notr">ESLint</b><small class="notr">JavaScript and TypeScript linting.</small><span class="notr">dbaeumer</span></div><button class="mini pri">Install</button></div><div class="ex-row"><span class="ex-ic" style="background:hsl(175 45% 45%)">C</span><div class="ex-t"><b class="notr">Code Spell Checker</b><small class="notr">Spelling checker for source code.</small><span class="notr">streetsidesoftware</span></div><button class="mini pri">Install</button></div><div class="ex-row"><span class="ex-ic" style="background:hsl(80 45% 45%)">E</span><div class="ex-t"><b class="notr">EditorConfig</b><small class="notr">Applies .editorconfig settings.</small><span class="notr">EditorConfig</span></div><button class="mini pri">Install</button></div><div class="scm-grp">Open VSX</div><div class="ex-row"><span class="ex-ic" style="background:hsl(2 45% 45%)">Y</span><div class="ex-t"><b class="notr">YAML</b><small class="notr">YAML validation, including Kubernetes schemas.</small><span class="notr">redhat</span></div><button class="mini pri">Install</button></div><div class="ex-row"><span class="ex-ic" style="background:hsl(228 45% 45%)">D</span><div class="ex-t"><b class="notr">Docker</b><small class="notr">Build, manage and run containers.</small><span class="notr">ms-azuretools</span></div><button class="mini pri">Install</button></div><div class="ex-row"><span class="ex-ic" style="background:hsl(56 45% 45%)">K</span><div class="ex-t"><b class="notr">Kubernetes</b><small class="notr">Develop, deploy and debug Kubernetes applications.</small><span class="notr">ms-kubernetes-tools</span></div><button class="mini pri">Install</button></div><div class="ex-row"><span class="ex-ic" style="background:hsl(172 45% 45%)">G</span><div class="ex-t"><b class="notr">Go</b><small class="notr">Go language support.</small><span class="notr">golang</span></div><button class="mini pri">Install</button></div><div class="ex-row"><span class="ex-ic" style="background:hsl(223 45% 45%)">P</span><div class="ex-t"><b class="notr">Python</b><small class="notr">Python language support.</small><span class="notr">ms-python</span></div><button class="mini pri">Install</button></div>
   <div class="sec-empty">Extensions come from Open VSX — the Microsoft Marketplace terms only allow Microsoft's own products. Availability varies by extension. In the browser only a few behave live (Error Lens, Prettier, YAML); the desktop app runs them all in a VS Code–compatible extension host.</div></div>"
`;

exports[`goldens de DOM — pane de extensões e tab de detalhe > tab de detalhe — GitLens (comando, não instalada) 1`] = `
