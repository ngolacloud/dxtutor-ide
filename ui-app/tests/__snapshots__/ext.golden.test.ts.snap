// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`goldens de DOM — pane de extensões e tab de detalhe > #pane-ext no browser: nada instalado, recomendadas pela pilha do projecto, funcionalidades do dxtutor 1`] = `
"<div class="side-hd"><span class="t">Extensions</span><span class="acts"><button title="Install from VSIX…"><svg class="ico" viewBox="0 0 16 16"><path d="M8 3v10M3 8h10"></path></svg></button></span></div><div class="sections"><input class="inp" id="ex-q" placeholder="Filter installed extensions" value=""><input type="file" id="vsix-in" accept=".vsix" style="display:none">
   <div class="scm-grp">Installed<span class="cnt">0</span></div><div class="sec-empty">None. Install from Open VSX or from a .vsix file (+).</div>
   <div class="scm-grp">Recommended for this project<span class="cnt">2</span></div><div class="ex-row"><span class="ex-ic" style="background:hsl(188 45% 45%)">r</span><div class="ex-t"><b class="notr">rust-analyzer</b><small class="notr">Rust project</small><span class="notr">rust-lang</span></div><button class="mini pri">Install</button></div><div class="ex-row"><span class="ex-ic" style="background:hsl(67 45% 45%)">v</span><div class="ex-t"><b class="notr">vscode-eslint</b><small class="notr">JavaScript/TypeScript project</small><span class="notr">dbaeumer</span></div><button class="mini pri">Install</button></div>
   
   <div class="scm-grp">Built into dxtutor</div><div class="ex-row"><div class="ex-t"><b>Inline diagnostics</b><small>Shows each problem at the end of its line in the editor.</small><span>dxtutor</span></div><button class="mini">Enable</button></div><div class="ex-row"><div class="ex-t"><b>YAML checks</b><small>Flags tab indentation in .yaml/.yml files and Kubernetes Deployments without resource requests (dxtutor's own checker, not a language server).</small><span>dxtutor</span></div><button class="mini">Enable</button></div><div class="ex-row"><div class="ex-t"><b>Format Document</b><small>Shift+Alt+F trims trailing spaces, normalises indentation and the final newline.</small><span>dxtutor · always on</span></div></div>
   <div class="sec-empty">Extensions come from Open VSX — the Microsoft Marketplace terms only allow Microsoft's own products. dxtutor applies what an extension contributes declaratively (themes, grammars, snippets, language settings, known language servers); there is no VS Code extension host, so extension code does not run. Searching and installing from Open VSX needs the desktop app.</div></div>"
`;

exports[`goldens de DOM — pane de extensões e tab de detalhe > tab de detalhe — id inexistente (extensão removida) 1`] = `"<div class="empty">Extension removed.</div>"`;

exports[`goldens de DOM — pane de extensões e tab de detalhe > tab de detalhe — uma recomendação ainda por instalar 1`] = `
"<div class="page" style="max-width:760px"><div style="display:flex;gap:16px;align-items:center"><span class="ex-ic big" style="background:hsl(188 45% 45%)">r</span><div><h1 class="notr" style="margin:0">rust-analyzer</h1><div class="sub notr" style="margin:0">rust-lang · <code>rust-lang.rust-analyzer</code></div></div></div>
   <div style="display:flex;gap:8px;margin:12px 0"><button class="mini pri">Install</button></div>
   <h2>Before you install</h2><div class="adv mix"><svg class="ico" viewBox="0 0 16 16"><path d="M8 1.8a4.2 4.2 0 0 0-2.4 7.6c.5.4.8.9.8 1.5V12h3.2v-1.1c0-.6.3-1.1.8-1.5A4.2 4.2 0 0 0 8 1.8z"></path><path d="M6.4 14h3.2"></path></svg><div>Recommended because of this project: Rust project. Installing downloads the VSIX from Open VSX (in the desktop app). dxtutor applies what it contributes declaratively — colour themes, TextMate grammars, snippets, language settings, and a known language server when it is on your PATH; its JavaScript does not run.</div></div>
   
   </div>"
`;
