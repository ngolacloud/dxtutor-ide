exports[`caracterização do motor — geradores de traço (a extrair p/ domain) > crashTrace: sonda de ops (crash de DNS com peer saudável) > crashTrace-dns 1`] = `
{
  "end": {
    "act": "openEnvs();SHOWSEC=true;rerender('envs')",
    "b": "<code>orders-worker</code>'s <code>DATABASE_URL</code> in staging points at <code>db.bad</code>, a name that does not exist in the cluster. The code is fine.<br><br><b>Fix (yours — secrets are a human change):</b> set the host to <code>db.staging</code> in the staging secrets, then redeploy staging.<br><br><b>To stop this happening again:</b> add a startup check that resolves every service host in the secrets before rollout, or make promotion run a DNS dry-run in the target namespace.",
    "ok": false,
    "t": "Root cause found",
  },
  "hk": {
    "code": "Bug in the worker",
    "cred": "Wrong credentials",
    "db": "Database is down",
    "host": "Wrong host in configuration",
  },
  "steps": [
    {
      "cmd": "kubectl -n dxtutor-staging get pod -l app=orders-worker",
      "focus": "how the process dies",
      "h": {
        "code": 20,
        "cred": 25,
        "db": 30,
        "host": 25,
      },
      "n": "Exit code <b>1</b>, not 137 — the OOM killer is not involved; the process exits on its own, early, every time. That points at startup configuration or a dependency, not load.",
      "out": "NAME                 READY   STATUS             RESTARTS   AGE
orders-worker-7d9f-x2lq   0/1     CrashLoopBackOff   6          4m

Last State: Terminated · Reason: Error · Exit Code: 1",
    },
    {
      "cmd": "kubectl -n dxtutor-staging logs orders-worker-7d9f-x2lq --previous",
      "focus": "what it fails on",
      "h": {
        "code": 14,
        "cred": 6,
        "db": 22,
        "host": 58,
      },
      "n": "The failure is a <b>DNS lookup</b>, not an authentication error: the name <code>db.bad</code> does not resolve. Wrong credentials would fail later, after connecting — I am dropping that one.",
      "out": "INFO starting orders-worker v0.1.0
INFO reading configuration from environment
ERROR dial tcp: lookup db.bad on 10.0.0.10:53: no such host",
    },
    {
      "cmd": "kubectl -n dxtutor-staging get pod -l app=orders-api",
      "focus": "whether the database is actually up",
      "h": {
        "code": 7,
        "cred": 4,
        "db": 3,
        "host": 86,
      },
      "n": "<code>orders-api</code> talks to the same database through <code>db.staging</code> and is healthy. So the database is up and reachable from this namespace. The difference must be in <code>orders-worker</code>'s own configuration.",
      "out": "NAME                     READY   STATUS    RESTARTS
orders-api-5c8b-k1pz   2/2     Running   0",
    },
    {
      "cmd": "dx secrets diff orders-worker --env local,staging --keys-only=false",
      "focus": "what differs between environments",
      "h": {
        "code": 0,
        "cred": 3,
        "db": 2,
        "host": 95,
      },
      "n": "Apart from the password, which is meant to differ, only the host changes: <code>db.staging</code> locally, <code>db.bad</code> in staging. Promotion checked that the key exists, not that the value is right.",
      "out": "DATABASE_URL
  local:   postgres://app:••••@db.staging:5432/orders
  staging: postgres://app:••••@db.bad:5432/orders",
    },
    {
      "cmd": "kubectl -n dxtutor-staging run dns-check --rm -i --image=busybox -- nslookup db.bad",
      "focus": "confirming the root cause",
      "h": {
        "code": 0,
        "cred": 1,
        "db": 1,
        "host": 98,
      },
      "n": "Confirmed: <code>db.bad</code> does not exist in the cluster; the service is <code>db.staging</code> (or <code>db.staging.dxtutor-staging.svc.cluster.local</code>).",
      "out": "** server can't find db.bad: NXDOMAIN

$ nslookup db.staging
Name: db.staging.dxtutor-staging.svc.cluster.local",
    },
  ],
}
`;

exports[`caracterização do motor — geradores de traço (a extrair p/ domain) > debugConfigs: lançadores (só lexer sem ambientes crash hidratados) > debugConfigs 1`] = `
[
  {
    "d": "cargo test -p lexer, under lldb",
    "id": "lexer",
    "l": "lexer · test tokenize_emits_eof",
  },
]
`;

exports[`caracterização do motor — geradores de traço (a extrair p/ domain) > lexTrace: passos + fim exactos por variante (clone/byref/whilelet/other) > lexTrace-byref 1`] = `
{
  "end": {
    "b": "The test passes. <code>by_ref()</code> keeps the loop on the original iterator, which is what the Eof check relies on.",
    "ok": true,
    "t": "No defect on this path",
  },
  "steps": [
    {
      "focus": "what decides whether Eof is pushed",
      "h": {
        "dig": 35,
        "eof": 40,
        "test": 25,
      },
      "l": 3,
      "n": "Entered <code>tokenize("12")</code> from the test <code>tokenize_emits_eof</code>, which expects the last token to be <code>Eof</code>. Three ways this fails: Eof never gets pushed, the digits are tokenized wrong, or the test expects the wrong thing. The only thing that decides Eof is whether <code>chars</code> is exhausted at line 10 — so <code>chars</code> is what I am watching.",
      "v": {
        "chars: Peekable<Chars>": "{ next '1', peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[] · len 0, cap 0",
      },
    },
    {
      "focus": "the iterator",
      "h": {
        "dig": 35,
        "eof": 40,
        "test": 25,
      },
      "l": 4,
      "n": "<code>tokens</code> is empty and has not allocated yet. <code>chars</code> becomes a <code>Peekable</code> over <code>"12"</code>; its cursor sits before <code>'1'</code>.",
      "v": {
        "chars: Peekable<Chars>": "{ next '1', peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[] · len 0, cap 0",
      },
    },
    {
      "focus": "how the loop consumes chars",
      "h": {
        "dig": 40,
        "eof": 36,
        "test": 24,
      },
      "l": 5,
      "n": "<code>chars.by_ref()</code> lends the iterator to the loop: the loop advances the original <code>chars</code>, and still gives it back afterwards. When the loop ends, <code>chars</code> should be exhausted.",
      "v": {
        "chars: Peekable<Chars>": "{ next '1', peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[] · len 0, cap 0",
      },
    },
    {
      "focus": "tokenizing digits",
      "h": {
        "dig": 22,
        "eof": 34,
        "test": 44,
      },
      "l": 6,
      "n": "<code>c = '1'</code> is an ASCII digit, so it will be pushed.",
      "v": {
        "c: char": "'1'",
        "chars: Peekable<Chars>": "{ next '2', peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[] · len 0, cap 0",
      },
    },
    {
      "focus": "tokenizing digits",
      "h": {
        "dig": 16,
        "eof": 32,
        "test": 52,
      },
      "l": 7,
      "n": "<code>tokens</code> allocated on the first push: capacity 4 (Rust's minimum for small elements). <code>Token</code> is 4 bytes thanks to the niche in <code>char</code>.",
      "v": {
        "c: char": "'1'",
        "chars: Peekable<Chars>": "{ next '2', peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[Num('1')] · len 1, cap 4",
      },
    },
    {
      "focus": "tokenizing digits",
      "h": {
        "dig": 8,
        "eof": 30,
        "test": 62,
      },
      "l": 6,
      "n": "Second character <code>'2'</code>. The original iterator advanced with the loop, as expected.",
      "v": {
        "c: char": "'2'",
        "chars: Peekable<Chars>": "{ next None, peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[Num('1')] · len 1, cap 4",
      },
    },
    {
      "focus": "tokenizing digits",
      "h": {
        "dig": 4,
        "eof": 24,
        "test": 72,
      },
      "l": 7,
      "n": "Both digits are in <code>tokens</code> — the digit handling is fine, so I am dropping that hypothesis.",
      "v": {
        "c: char": "'2'",
        "chars: Peekable<Chars>": "{ next None, peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[Num('1'), Num('2')] · len 2, cap 4",
      },
    },
    {
      "ev": true,
      "focus": "the Eof condition",
      "h": {
        "dig": 2,
        "eof": 3,
        "test": 6,
      },
      "l": 10,
      "n": "<code>chars.peek()</code> is <code>None</code>: the original iterator is exhausted, so the condition is true and <code>Eof</code> will be pushed. Nothing suspicious on this path.",
      "v": {
        "chars.peek()": "None",
        "chars: Peekable<Chars>": "{ next None, peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[Num('1'), Num('2')] · len 2, cap 4",
      },
    },
    {
      "focus": "the Eof condition",
      "h": {
        "dig": 2,
        "eof": 2,
        "test": 4,
      },
      "l": 11,
      "n": "<code>Eof</code> pushed.",
      "v": {
        "chars.peek()": "None",
        "chars: Peekable<Chars>": "{ next None, peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[Num('1'), Num('2'), Eof] · len 3, cap 4",
      },
    },
    {
      "focus": "the result",
      "h": {
        "dig": 2,
        "eof": 2,
        "test": 3,
      },
      "l": 13,
      "n": "Returns <code>[Num('1'), Num('2'), Eof]</code>. The test's assertion holds.",
      "v": {
        "chars: Peekable<Chars>": "{ next None, peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[Num('1'), Num('2'), Eof] · len 3, cap 4",
      },
    },
  ],
}
`;

exports[`caracterização do motor — geradores de traço (a extrair p/ domain) > lexTrace: passos + fim exactos por variante (clone/byref/whilelet/other) > lexTrace-clone 1`] = `
{
  "end": {
    "b": "The compiler's suggestion fixed the <b>compile</b> error but changed the <b>behaviour</b>: cloning a <code>Peekable</code> gives the loop its own cursor, so the original never reaches the end and <code>peek()</code> keeps seeing <code>'1'</code>.<br><br><b>Fix:</b> lend the iterator instead of copying it — <code>for c in chars.by_ref()</code>. It compiles for the same reason the clone did (the loop no longer takes ownership), and it keeps a single cursor.<br><br><b>Lesson:</b> when <code>rustc</code> says “consider cloning”, ask whether you need a second value or just a second <i>use</i> of the same one. For iterators it is almost always the second.",
    "fix": [Function],
    "ok": false,
    "t": "Root cause found",
  },
  "steps": [
    {
      "focus": "what decides whether Eof is pushed",
      "h": {
        "dig": 35,
        "eof": 40,
        "test": 25,
      },
      "l": 3,
      "n": "Entered <code>tokenize("12")</code> from the test <code>tokenize_emits_eof</code>, which expects the last token to be <code>Eof</code>. Three ways this fails: Eof never gets pushed, the digits are tokenized wrong, or the test expects the wrong thing. The only thing that decides Eof is whether <code>chars</code> is exhausted at line 10 — so <code>chars</code> is what I am watching.",
      "v": {
        "chars: Peekable<Chars>": "{ next '1', peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[] · len 0, cap 0",
      },
    },
    {
      "focus": "the iterator",
      "h": {
        "dig": 35,
        "eof": 40,
        "test": 25,
      },
      "l": 4,
      "n": "<code>tokens</code> is empty and has not allocated yet. <code>chars</code> becomes a <code>Peekable</code> over <code>"12"</code>; its cursor sits before <code>'1'</code>.",
      "v": {
        "chars: Peekable<Chars>": "{ next '1', peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[] · len 0, cap 0",
      },
    },
    {
      "focus": "how the loop consumes chars",
      "h": {
        "dig": 27,
        "eof": 58,
        "test": 15,
      },
      "l": 5,
      "n": "The loop iterates over <code>chars.clone()</code>: a <b>copy</b> of the iterator. Everything the loop consumes comes out of the copy — the original <code>chars</code> will not move. That is the first thing I would flag; I will confirm it at line 10.",
      "v": {
        "(loop copy) Chars": "{ next '1' }",
        "chars: Peekable<Chars>": "{ next '1', peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[] · len 0, cap 0",
      },
    },
    {
      "focus": "tokenizing digits",
      "h": {
        "dig": 22,
        "eof": 62,
        "test": 16,
      },
      "l": 6,
      "n": "<code>c = '1'</code> is an ASCII digit, so it will be pushed.",
      "v": {
        "(loop copy) Chars": "{ next '2' }",
        "c: char": "'1'",
        "chars: Peekable<Chars>": "{ next '1', peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[] · len 0, cap 0",
      },
    },
    {
      "focus": "tokenizing digits",
      "h": {
        "dig": 16,
        "eof": 64,
        "test": 20,
      },
      "l": 7,
      "n": "<code>tokens</code> allocated on the first push: capacity 4 (Rust's minimum for small elements). <code>Token</code> is 4 bytes thanks to the niche in <code>char</code>.",
      "v": {
        "(loop copy) Chars": "{ next '2' }",
        "c: char": "'1'",
        "chars: Peekable<Chars>": "{ next '1', peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[Num('1')] · len 1, cap 4",
      },
    },
    {
      "focus": "tokenizing digits",
      "h": {
        "dig": 8,
        "eof": 66,
        "test": 26,
      },
      "l": 6,
      "n": "Second character <code>'2'</code>. Note the variables: the <b>copy</b> is advancing, the original <code>chars</code> still says <code>next '1'</code>.",
      "v": {
        "(loop copy) Chars": "{ next None }",
        "c: char": "'2'",
        "chars: Peekable<Chars>": "{ next '1', peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[Num('1')] · len 1, cap 4",
      },
    },
    {
      "focus": "tokenizing digits",
      "h": {
        "dig": 4,
        "eof": 70,
        "test": 26,
      },
      "l": 7,
      "n": "Both digits are in <code>tokens</code> — the digit handling is fine, so I am dropping that hypothesis.",
      "v": {
        "(loop copy) Chars": "{ next None }",
        "c: char": "'2'",
        "chars: Peekable<Chars>": "{ next '1', peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[Num('1'), Num('2')] · len 2, cap 4",
      },
    },
    {
      "ev": true,
      "focus": "the Eof condition",
      "h": {
        "dig": 2,
        "eof": 94,
        "test": 4,
      },
      "l": 10,
      "n": "Here it is. <code>chars.peek()</code> returns <code>Some('1')</code>: the original iterator was <b>never advanced</b>, because the loop consumed the copy. The condition is false, so <code>Eof</code> is skipped. This explains the test failure completely; the other two hypotheses are ruled out by what we saw.",
      "v": {
        "chars.peek()": "Some('1')",
        "chars: Peekable<Chars>": "{ next '1', peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[Num('1'), Num('2')] · len 2, cap 4",
      },
    },
    {
      "focus": "the result",
      "h": {
        "dig": 1,
        "eof": 97,
        "test": 2,
      },
      "l": 13,
      "n": "Returns <code>[Num('1'), Num('2')]</code> — no <code>Eof</code>. The test will fail with <code>left: Some(Num('2')), right: Some(Eof)</code>.",
      "v": {
        "chars: Peekable<Chars>": "{ next '1', peeked: None }",
        "src: &str": ""12"",
        "tokens: Vec<Token>": "[Num('1'), Num('2')] · len 2, cap 4",
      },
    },
  ],
}
`;

