exports[`golden de DOM — Run and Debug (renderDebugPane / drawDbg) > com breakpoints: a lista mostra ficheiro e linha > pane-breakpoints 1`] = `
"<div class="side-hd"><span class="t">Run and Debug</span><span class="acts"></span></div><div class="sections"><button class="btn">Start debugging (F5)</button><div class="sec-empty">Step-by-step debugging with gdb (Rust, C, C++): in a Cargo project it builds and runs the binary; otherwise it asks for the executable. Put breakpoints in the gutter or with F9.</div>
   <div class="scm-grp">Breakpoints<span class="cnt">2</span></div><div class="scm-row"><span class="bpd"></span><span class="nm notr">lib.rs</span><span class="pth">line 5</span><span class="ra" style="display:flex"><button>×</button></span></div><div class="scm-row"><span class="bpd"></span><span class="nm notr">lib.rs</span><span class="pth">line 10</span><span class="ra" style="display:flex"><button>×</button></span></div></div>"
`;

exports[`golden de DOM — Run and Debug (renderDebugPane / drawDbg) > sem sessão: o pane oferece começar (gdb) e o assistente explica como > feed-no-session 1`] = `"<div class="dbg-empty"><svg class="ico" viewBox="0 0 16 16"><path d="M5.5 5.5a2.5 2.5 0 0 1 5 0"></path><rect x="4.5" y="5.5" width="7" height="8" rx="3.5"></rect><path d="M8 8v5M2 8.5h2.5M11.5 8.5H14M2.5 12l2-1M13.5 12l-2-1M2.5 5l2 1.2M13.5 5l-2 1.2"></path></svg><div><b>Debug assistant</b><p>No debugging session. Put breakpoints in the gutter (F9) and press F5: gdb runs the program and stops at them. With a folder open in the desktop app, this panel also shows the commands that failed and the workspace errors.</p></div></div>"`;

exports[`golden de DOM — Run and Debug (renderDebugPane / drawDbg) > sem sessão: o pane oferece começar (gdb) e o assistente explica como > pane-no-session 1`] = `
"<div class="side-hd"><span class="t">Run and Debug</span><span class="acts"></span></div><div class="sections"><button class="btn">Start debugging (F5)</button><div class="sec-empty">Step-by-step debugging with gdb (Rust, C, C++): in a Cargo project it builds and runs the binary; otherwise it asks for the executable. Put breakpoints in the gutter or with F9.</div>
   <div class="scm-grp">Breakpoints<span class="cnt">0</span></div><div class="sec-empty">Click the gutter or press <kbd>F9</kbd> to add one.</div></div>"
`;
