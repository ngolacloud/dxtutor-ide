exports[`goldens de DOM — Under the hood (VIEW.hood) > hood do lexer semeado (pipeline do compilador + memória + posse, variante bug) 1`] = `
"<div class="page" style="max-width:860px"><h1>Under the hood</h1><div class="sub notr">crates/lexer/src/lib.rs</div><h2>Compiler pipeline</h2><div class="hood-p"><div class="hs ok"><span>✓</span><div><b>Lex &amp; parse</b><small>source → tokens → syntax tree</small></div></div><div class="hs ok"><span>✓</span><div><b>Name resolution &amp; macros</b><small>paths, use statements, derive(Debug, PartialEq)</small></div></div><div class="hs ok"><span>✓</span><div><b>Type check</b><small>every expression gets a type</small></div></div><div class="hs bad"><span>✖</span><div><b>Borrow check</b><small><code>chars</code> moved into the loop at line 5, used again at line 10 (E0382)</small></div></div><div class="hs skip"><span>○</span><div><b>MIR &amp; optimisation</b><small>not reached</small></div></div><div class="hs skip"><span>○</span><div><b>LLVM codegen</b><small>not reached</small></div></div></div><h2>Memory</h2><div class="tbl-wrap"><table class="tbl"><tbody><tr><th>Value</th><th>Where</th><th>Size</th><th>Why</th></tr><tr><td><code>Token</code></td><td class="c">—</td><td>4 bytes</td><td class="c"><code>Num(char)</code> and <code>Eof</code> fit in one <code>char</code>: Eof uses an invalid code point as its tag (niche optimisation).</td></tr><tr><td><code>tokens: Vec&lt;Token&gt;</code></td><td class="c">stack + heap</td><td>24 B + 4×cap</td><td class="c">pointer, capacity, length on the stack; the first push allocates capacity 4.</td></tr><tr><td><code>chars: Peekable&lt;Chars&gt;</code></td><td class="c">stack</td><td>≈24 bytes</td><td class="c">two pointers into the string plus the peeked slot; no heap allocation.</td></tr></tbody></table></div>
      <h2>Ownership of <code>chars</code></h2><div class="hood-o"><div><b>line 4</b><span class="tag ">created</span><small>owned by tokenize</small></div><div><b>line 5</b><span class="tag ">moved</span><small>into_iter() takes it — gone after the loop</small></div><div><b>line 10</b><span class="tag bad">✖ use after move</span><small>rejected by the borrow checker</small></div></div><div class="sub">Time O(n), one pass; memory O(n) for the tokens.</div><div class="sub" style="margin-top:20px">Derived from the code in this workspace.</div></div>"
`;
