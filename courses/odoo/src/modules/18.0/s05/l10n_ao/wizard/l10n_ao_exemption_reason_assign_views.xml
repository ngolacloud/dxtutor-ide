<odoo>
    <record id="l10n_ao_exemption_reason_assign_view_form" model="ir.ui.view">
        <field name="name">l10n_ao.exemption.reason.assign.form</field>
        <field name="model">l10n_ao.exemption.reason.assign</field>
        <field name="arch" type="xml">
            <form string="Assign an Exemption Reason">
                <group>
                    <field name="reason_id" options="{'no_create': True}"/>
                    <field name="tax_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_assign" string="Assign" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_ao_exemption_reason_assign" model="ir.actions.act_window">
        <field name="name">Assign Exemption Reason (AO)</field>
        <field name="res_model">l10n_ao.exemption.reason.assign</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_tax"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>
</odoo>
