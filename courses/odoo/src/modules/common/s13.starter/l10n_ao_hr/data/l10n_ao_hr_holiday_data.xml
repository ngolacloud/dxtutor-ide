<!-- Part of the dxtutor Odoo course (l10n_ao_hr). License: LGPL-3.
     The twelve feriados nacionais of Lei n.º 10/11, art. 2.º, as amended by Lei n.º 11/18 (no later
     amendment found up to Aug 2026). Rules, not dates: the person responsible edits and extends them
     (a municipal holiday, a new law) in Employees > Configuration > Angola, and noupdate="1" keeps
     those edits. The datas de celebração nacional (art. 3.º) are not days off and are not here. -->
<odoo noupdate="1">
    <record id="holiday_ano_novo" model="l10n_ao_hr.holiday">
        <field name="name">Dia do Ano Novo</field>
        <field name="rule">fixed</field>
        <field name="day">1</field>
        <field name="month">1</field>
        <field name="source">Lei n.º 10/11, de 16 de Fevereiro, art. 2.º (redacção da Lei n.º 11/18, de 28 de Setembro)</field>
    </record>
    <record id="holiday_inicio_luta_armada" model="l10n_ao_hr.holiday">
